# Maintainer: Bayraktar1392 <179267358+Bayraktar1392@users.noreply.github.com>
pkgname=clipper
pkgver=2.0.0
pkgrel=1
pkgdesc='Minimal native GTK4/libadwaita downloader for Twitch Clips and YouTube videos'
arch=('x86_64')
url='https://github.com/Bayraktar1392/Clipper'
license=('MIT')
depends=('gtk4' 'libadwaita' 'yt-dlp' 'ffmpeg')
makedepends=('rust' 'pkgconf')
source=("https://github.com/Bayraktar1392/Clipper/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    cargo build --release
}

package() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    install -Dm755 "target/release/${pkgname}" \
        "${pkgdir}/usr/bin/${pkgname}"

    install -Dm644 assets/clipper.desktop \
        "${pkgdir}/usr/share/applications/clipper.desktop"

    install -Dm644 assets/icons/hicolor/scalable/apps/clipper.svg \
        "${pkgdir}/usr/share/icons/hicolor/scalable/apps/clipper.svg"

    install -Dm644 LICENSE \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
